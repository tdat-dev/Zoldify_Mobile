{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_ORIGIN": "https://api.zoldify.com",
        "EXPO_PUBLIC_MEDIA_ORIGIN": "https://zoldify.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_ORIGIN": "https://api.zoldify.com",
        "EXPO_PUBLIC_MEDIA_ORIGIN": "https://zoldify.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_ORIGIN": "https://api.zoldify.com",
        "EXPO_PUBLIC_MEDIA_ORIGIN": "https://zoldify.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
